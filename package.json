{
  "name": "markdown-lens",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=26.13.1",
    "npm": ">=11.20.0"
  },
  "description": "A privacy-first local Markdown editor and document converter for PDF, Word, Office, HTML, EPUB, and images in the browser.",
  "scripts": {
    "predev": "node scripts/copy-ocr-data.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-ocr-data.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:release": "node scripts/check-release-updates.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:rendering": "playwright test tests/e2e/rendering.spec.ts",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "test:a11y": "playwright test --grep @a11y",
    "test:a11y:mobile": "playwright test --grep @a11y --project=mobile"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/search": "^6.7.3",
    "@codemirror/view": "^6.44.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@uiw/react-codemirror": "^4.25.13",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.12.1",
    "fflate": "^0.8.3",
    "github-slugger": "^2.0.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.80.0",
    "lz-string": "^1.5.0",
    "mammoth": "^1.13.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^12.3.0",
    "next": "^16.4.6",
    "papaparse": "^5.7.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.7.1",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.10",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.15",
    "brace-expansion": "^5.0.12",
    "dompurify": "^3.4.17",
    "js-yaml": "^4.3.2",
    "minimatch": "^11.0.9",
    "nanoid": "^3.3.18",
    "postcss": "$postcss",
    "postcss-selector-parser": "^6.1.6",
    "fast-uri": "^4.1.4",
    "sharp": "^0.35.5",
    "katex": "^0.18.11",
    "zod": "^4.6.7"
  },
  "packageManager": "npm@11.20.0"
}
