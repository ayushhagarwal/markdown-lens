{
  "name": "markdown-lens",
  "version": "0.9.4",
  "private": true,
  "description": "A privacy-first local Markdown editor and document converter for PDF, Word, Office, HTML, EPUB, and images in the browser.",
  "scripts": {
    "predev": "node scripts/copy-ocr-data.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-ocr-data.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:release": "node scripts/check-release-updates.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:rendering": "playwright test tests/e2e/rendering.spec.ts",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "test:a11y": "playwright test --grep @a11y"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/search": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@tailwindcss/typography": "^0.5.19",
    "@tesseract.js-data/eng": "^1.0.0",
    "@uiw/react-codemirror": "^4.25.11",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3",
    "github-slugger": "^2.0.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.24.0",
    "lz-string": "^1.5.0",
    "mammoth": "^1.12.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.16.0",
    "next": "^16.2.12",
    "papaparse": "^5.5.4",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.7",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "rehype-highlight": "^7.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@openai/codex-security": "^0.1.12",
    "@playwright/test": "^1.55.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.2",
    "@types/turndown": "^5.0.6",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.2.12",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.24",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.6",
    "postcss": "^8.5.24",
    "sharp": "^0.35.3"
  }
}
